[gd_resource type="Resource" script_class="SporeCinematicDefinition" load_steps=6 format=3]

[ext_resource type="Script" path="res://scripts/data/cinematic_definition.gd" id="1_cine"]
[ext_resource type="Script" path="res://scripts/data/battle_action_definition.gd" id="2_action"]

[sub_resource type="Resource" id="Fade"]
script = ExtResource("2_action")
id = "fade"
action_type = "fade_out"
camera_duration = 0.12

[sub_resource type="Resource" id="Focus"]
script = ExtResource("2_action")
id = "focus"
action_type = "camera_focus_unit"
unit_id = "archiviste"
camera_zoom = 1.65
camera_duration = 0.25

[sub_resource type="Resource" id="In"]
script = ExtResource("2_action")
id = "in"
action_type = "fade_in"
camera_duration = 0.18

[sub_resource type="Resource" id="Line"]
script = ExtResource("2_action")
id = "line"
action_type = "dialogue"
speaker = "L'Archiviste"
message = "Phase finale. Vous êtes reclassés dans la catégorie : dégâts collatéraux."
wait_for_input = true

[sub_resource type="Resource" id="Reset"]
script = ExtResource("2_action")
id = "reset"
action_type = "camera_reset"
camera_duration = 0.25

[resource]
script = ExtResource("1_cine")
id = "archivist_phase3"
display_name = "Archiviste — Phase III"
description = "Transition réutilisable de la phase finale."
actions = Array[Resource]([SubResource("Fade"), SubResource("Focus"), SubResource("In"), SubResource("Line"), SubResource("Reset")])
