[gd_resource type="Resource" script_class="SporeCinematicDefinition" load_steps=4 format=3]

[ext_resource type="Script" path="res://scripts/data/cinematic_definition.gd" id="1_cine"]
[ext_resource type="Script" path="res://scripts/data/battle_action_definition.gd" id="2_action"]

[sub_resource type="Resource" id="Focus"]
script = ExtResource("2_action")
id = "focus_carrier"
action_type = "camera_focus_cell"
cell = Vector2i(0, 7)
camera_zoom = 1.2
camera_duration = 0.25

[sub_resource type="Resource" id="Dialogue"]
script = ExtResource("2_action")
id = "victory_line"
action_type = "dialogue"
speaker = "Narrateur"
message = "La Couronne quitte le jardin sous les applaudissements imaginaires d'un public extrêmement exigeant."
wait_for_input = true

[sub_resource type="Resource" id="Reset"]
script = ExtResource("2_action")
id = "reset"
action_type = "camera_reset"
camera_duration = 0.2

[resource]
script = ExtResource("1_cine")
id = "victory_crown"
display_name = "Victoire — Couronne"
description = "Courte sortie de mission."
actions = Array[Resource]([SubResource("Focus"), SubResource("Dialogue"), SubResource("Reset")])
