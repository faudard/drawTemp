[gd_resource type="Resource" script_class="SporeCinematicDefinition" load_steps=3 format=3]

[ext_resource type="Script" path="res://scripts/data/cinematic_definition.gd" id="1_cine"]
[ext_resource type="Script" path="res://scripts/data/battle_action_definition.gd" id="2_action"]

[sub_resource type="Resource" id="Dialogue"]
script = ExtResource("2_action")
id = "defeat_line"
action_type = "dialogue"
speaker = "Narrateur"
message = "La troupe se replie. Même les légendes ont parfois besoin de retourner régler leurs modules dans la Serre tactique."
wait_for_input = true

[sub_resource type="Resource" id="Reset"]
script = ExtResource("2_action")
id = "reset"
action_type = "camera_reset"
camera_duration = 0.2

[resource]
script = ExtResource("1_cine")
id = "defeat_generic"
display_name = "Défaite générique"
description = "Séquence de défaite réutilisable."
actions = Array[Resource]([SubResource("Dialogue"), SubResource("Reset")])
