cell = Vector2i(7, 2)
linked_object_id = ""
starts_active = false
one_shot = true
reward_type = "focus_team"
reward_value = 1
reward_team = "player"

[resource]
script = ExtResource("1_mission")
id = "crown"
display_name = "La Couronne Beatbox"
brief = "Infiltre le jardin, récupère ♛ puis ramène-la dans la zone verte. Les vinyles restent optionnels."
secondary_objective = "Collection complète — récupérer les 2 vinyles"
objective = "crown"
survival_rounds = 0
grid_width = 10
grid_height = 8
map_scene_path = "res://maps/mission_1_map.tscn"
intro_cinematic_id = "intro_crown"
victory_cinematic_id = "victory_crown"
defeat_cinematic_id = "defeat_crown"
victory_rule_mode = "any"
victory_rules = Array[Resource]([SubResource("Victory_1")])
defeat_rule_mode = "any"
defeat_rules = Array[Resource]([SubResource("Defeat_1")])
battle_triggers = Array[Resource]([SubResource("Trigger_1")])
interactables = Array[Resource]([SubResource("Door_1"), SubResource("Switch_1"), SubResource("Chest_1")])
obstacles = Array[Vector2i]([Vector2i(4, 2), Vector2i(5, 2), Vector2i(4, 5), Vector2i(5, 5), Vector2i(7, 3), Vector2i(2, 3)])
cover = Array[Vector2i]([Vector2i(1, 2), Vector2i(3, 4), Vector2i(6, 4), Vector2i(6, 6), Vector2i(8, 5)])
