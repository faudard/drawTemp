extraction = Array[Vector2i]([Vector2i(0, 7), Vector2i(0, 6), Vector2i(1, 7)])
bonus = Array[Vector2i]([Vector2i(3, 0), Vector2i(7, 7)])
crown = Vector2i(9, 0)
height_level_1 = Array[Vector2i]([Vector2i(1, 1), Vector2i(2, 1), Vector2i(3, 5), Vector2i(3, 6), Vector2i(6, 1), Vector2i(6, 2), Vector2i(8, 4)])
height_level_2 = Array[Vector2i]([Vector2i(8, 5)])
hero_starts = Array[Vector2i]([Vector2i(1, 6), Vector2i(2, 7), Vector2i(0, 6)])
enemy_ids = PackedStringArray("grincheux", "baveux", "comptable", "dj_morille")
