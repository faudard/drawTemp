linked_object_id = ""
starts_active = false
one_shot = true
reward_type = "none"
reward_value = 0
reward_team = "player"

[sub_resource type="Resource" id="Switch_1"]
script = ExtResource("5_object")
id = "garden_switch"
display_name = "Champignon-interrupteur"
object_type = "switch"
cell = Vector2i(2, 6)
linked_object_id = "garden_gate"
