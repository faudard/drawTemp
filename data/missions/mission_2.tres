[gd_resource type="Resource" script_class="SporeMissionDefinition" load_steps=14 format=3]

[ext_resource type="Script" path="res://scripts/data/mission_definition.gd" id="1_mission"]
[ext_resource type="Script" path="res://scripts/data/mission_rule.gd" id="2_rule"]
[ext_resource type="Script" path="res://scripts/data/battle_trigger_definition.gd" id="3_trigger"]
[ext_resource type="Script" path="res://scripts/data/battle_action_definition.gd" id="4_action"]

[sub_resource type="Resource" id="Victory_1"]
script = ExtResource("2_rule")
rule_type = "survive_rounds"
amount = 3
unit_id = ""
invert = false
description = ""

[sub_resource type="Resource" id="Victory_2"]
script = ExtResource("2_rule")
rule_type = "all_enemies_defeated"
amount = 1
unit_id = ""
invert = false
description = ""

[sub_resource type="Resource" id="Defeat_1"]
script = ExtResource("2_rule")
rule_type = "all_players_defeated"
amount = 1
unit_id = ""
invert = false
description = ""

[sub_resource type="Resource" id="Action_1"]
script = ExtResource("4_action")
id = "wave_message"
action_type = "message"
message = "RENFORT ! Un Baveux retardataire glisse depuis les coulisses."

[sub_resource type="Resource" id="Action_2"]
script = ExtResource("4_action")
id = "wave_wait"
action_type = "wait"
delay_seconds = 0.5

[sub_resource type="Resource" id="Action_3"]
script = ExtResource("4_action")
id = "wave_spawn"
action_type = "spawn_enemy"
unit_id = "baveux"
cell = Vector2i(8, 0)
team = "enemy"

[sub_resource type="Resource" id="Trigger_1"]
script = ExtResource("3_trigger")
id = "wave_2"
enabled = true
once = true
condition_type = "round_start"
condition_value = 2
condition_unit_id = ""
condition_cell = Vector2i(-1, -1)
actions = Array[Resource]([SubResource("Action_1"), SubResource("Action_2"), SubResource("Action_3")])

[sub_resource type="Resource" id="Action_Zone"]
script = ExtResource("4_action")
id = "center_stage_message"
action_type = "message"
message = "Tu occupes le centre de scène — parfait pour attirer toute la salle."

[sub_resource type="Resource" id="Trigger_Zone"]
script = ExtResource("3_trigger")
id = "enter_center_stage"
enabled = true
once = true
condition_type = "player_enters_zone"
condition_value = 1
condition_unit_id = ""
condition_cell = Vector2i(-1, -1)
condition_zone_id = "center_stage"
actions = Array[Resource]([SubResource("Action_Zone")])

[resource]
script = ExtResource("1_mission")
id = "stage"
display_name = "Tenir la Scène"
brief = "Survis 3 manches au milieu des spores, ou mets toute la bande adverse K.O. avant la fin."
secondary_objective = "Standing ovation — terminer avec les 3 héros debout"
objective = "survive"
survival_rounds = 3
grid_width = 10
grid_height = 8
map_scene_path = "res://maps/mission_2_map.tscn"
intro_cinematic_id = "intro_stage"
victory_cinematic_id = ""
defeat_cinematic_id = "defeat_generic"
victory_rule_mode = "any"
victory_rules = Array[Resource]([SubResource("Victory_1"), SubResource("Victory_2")])
defeat_rule_mode = "any"
defeat_rules = Array[Resource]([SubResource("Defeat_1")])
battle_triggers = Array[Resource]([SubResource("Trigger_1"), SubResource("Trigger_Zone")])
interactables = Array[Resource]([])
obstacles = Array[Vector2i]([Vector2i(2, 2), Vector2i(7, 2), Vector2i(2, 5), Vector2i(7, 5), Vector2i(4, 3), Vector2i(5, 4)])
cover = Array[Vector2i]([Vector2i(3, 2), Vector2i(6, 2), Vector2i(3, 5), Vector2i(6, 5)])
hazards = Array[Vector2i]([Vector2i(0, 1), Vector2i(1, 1), Vector2i(8, 6), Vector2i(9, 6), Vector2i(4, 1), Vector2i(6, 6)])
extraction = Array[Vector2i]([])
bonus = Array[Vector2i]([Vector2i(0, 7), Vector2i(9, 0)])
crown = Vector2i(-9, -9)
height_level_1 = Array[Vector2i]([Vector2i(3, 3), Vector2i(6, 4), Vector2i(4, 6), Vector2i(5, 1)])
height_level_2 = Array[Vector2i]([Vector2i(4, 0), Vector2i(5, 7)])
hero_starts = Array[Vector2i]([Vector2i(4, 6), Vector2i(5, 6), Vector2i(4, 7)])
enemy_ids = PackedStringArray("baveux", "grincheux", "comptable", "choriste", "dj_morille")
enemy_positions = Array[Vector2i]([Vector2i(1, 1), Vector2i(8, 1), Vector2i(9, 4), Vector2i(0, 4), Vector2i(5, 0)])
enemy_roles = PackedStringArray("Gluant", "Garde", "Archer fiscal", "Harceleur", "Disc-jockey hostile")
enemy_hp_overrides = PackedInt32Array(8, 9, -1, -1, 8)
enemy_attack_overrides = PackedInt32Array(-1, -1, -1, -1, -1)
enemy_move_overrides = PackedInt32Array(4, -1, -1, -1, -1)
enemy_range_overrides = PackedInt32Array(-1, -1, -1, -1, -1)
