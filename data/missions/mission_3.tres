[gd_resource type="Resource" script_class="SporeMissionDefinition" load_steps=15 format=3]

[ext_resource type="Script" path="res://scripts/data/mission_definition.gd" id="1_mission"]
[ext_resource type="Script" path="res://scripts/data/mission_rule.gd" id="2_rule"]
[ext_resource type="Script" path="res://scripts/data/battle_trigger_definition.gd" id="3_trigger"]
[ext_resource type="Script" path="res://scripts/data/battle_action_definition.gd" id="4_action"]

[sub_resource type="Resource" id="Victory_1"]
script = ExtResource("2_rule")
rule_type = "all_enemies_defeated"
amount = 1
unit_id = ""
invert = false
description = ""

[sub_resource type="Resource" id="Defeat_1"]
script = ExtResource("2_rule")
rule_type = "all_players_defeated"
amount = 1
unit_id = ""
invert = false
description = ""

[sub_resource type="Resource" id="P2_1"]
script = ExtResource("4_action")
id = "phase2_cinematic"
action_type = "play_cinematic"
cinematic_id = "archivist_phase2"

[sub_resource type="Resource" id="P2_2"]
script = ExtResource("4_action")
id = "phase2_wait"
action_type = "wait"
delay_seconds = 0.4

[sub_resource type="Resource" id="P2_3"]
script = ExtResource("4_action")
id = "phase2_state"
action_type = "set_phase"
message = "II"

[sub_resource type="Resource" id="Trigger_1"]
script = ExtResource("3_trigger")
id = "archivist_phase_2"
enabled = true
once = true
condition_type = "unit_hp_at_most"
condition_value = 10
condition_unit_id = "archiviste"
condition_cell = Vector2i(-1, -1)
actions = Array[Resource]([SubResource("P2_1"), SubResource("P2_2"), SubResource("P2_3")])

[sub_resource type="Resource" id="P3_1"]
script = ExtResource("4_action")
id = "phase3_cinematic"
action_type = "play_cinematic"
cinematic_id = "archivist_phase3"

[sub_resource type="Resource" id="P3_2"]
script = ExtResource("4_action")
id = "phase3_state"
action_type = "set_phase"
message = "III"

[sub_resource type="Resource" id="P3_3"]
script = ExtResource("4_action")
id = "phase3_objective"
action_type = "set_objective_text"
message = "Dernier rappel : neutraliser l’Archiviste et sa troupe."

[sub_resource type="Resource" id="Trigger_2"]
script = ExtResource("3_trigger")
id = "archivist_phase_3"
enabled = true
once = true
condition_type = "unit_hp_at_most"
condition_value = 5
condition_unit_id = "archiviste"
condition_cell = Vector2i(-1, -1)
actions = Array[Resource]([SubResource("P3_1"), SubResource("P3_2"), SubResource("P3_3")])

[resource]
script = ExtResource("1_mission")
id = "finale"
display_name = "Dernier Rappel"
brief = "Élimine la troupe d'élite. Le terrain est plus vertical et les angles de tir comptent davantage."
secondary_objective = "Rappel express — gagner avant la fin de la manche 4"
objective = "eliminate"
survival_rounds = 0
grid_width = 10
grid_height = 8
map_scene_path = "res://maps/mission_3_map.tscn"
intro_cinematic_id = "intro_finale"
victory_cinematic_id = "victory_finale"
defeat_cinematic_id = "defeat_generic"
victory_rule_mode = "any"
victory_rules = Array[Resource]([SubResource("Victory_1")])
defeat_rule_mode = "any"
defeat_rules = Array[Resource]([SubResource("Defeat_1")])
battle_triggers = Array[Resource]([SubResource("Trigger_1"), SubResource("Trigger_2")])
interactables = Array[Resource]([])
obstacles = Array[Vector2i]([Vector2i(3, 1), Vector2i(6, 1), Vector2i(3, 6), Vector2i(6, 6), Vector2i(4, 3), Vector2i(5, 3), Vector2i(4, 4), Vector2i(5, 4)])
cover = Array[Vector2i]([Vector2i(1, 3), Vector2i(2, 5), Vector2i(7, 2), Vector2i(8, 4), Vector2i(5, 6)])
hazards = Array[Vector2i]([Vector2i(2, 1), Vector2i(7, 1), Vector2i(2, 6), Vector2i(7, 6), Vector2i(0, 4), Vector2i(9, 3)])
extraction = Array[Vector2i]([])
bonus = Array[Vector2i]([Vector2i(1, 0), Vector2i(8, 7)])
crown = Vector2i(-9, -9)
height_level_1 = Array[Vector2i]([Vector2i(1, 2), Vector2i(2, 2), Vector2i(7, 5), Vector2i(8, 5), Vector2i(4, 1), Vector2i(6, 6)])
height_level_2 = Array[Vector2i]([Vector2i(0, 0), Vector2i(9, 7), Vector2i(5, 0)])
hero_starts = Array[Vector2i]([Vector2i(0, 7), Vector2i(1, 7), Vector2i(0, 6)])
enemy_ids = PackedStringArray("grincheux", "baveux", "comptable", "dj_morille", "archiviste")
enemy_positions = Array[Vector2i]([Vector2i(8, 0), Vector2i(9, 2), Vector2i(5, 0), Vector2i(8, 5), Vector2i(5, 7)])
enemy_roles = PackedStringArray("Garde d'élite", "Gluant vétéran", "Archer fiscal senior", "Chef de piste", "Boss mycélien")
enemy_hp_overrides = PackedInt32Array(11, 9, 11, 10, -1)
enemy_attack_overrides = PackedInt32Array(3, -1, 3, 3, -1)
enemy_move_overrides = PackedInt32Array(-1, 4, -1, -1, -1)
enemy_range_overrides = PackedInt32Array(-1, -1, 4, -1, -1)
