      {
        "id": "sc_p0_visions",
        "title": "Une bannière, une couronne, un bûcher",
        "speaker": "Les Voix",
        "text": "Une couronne tachée de sang. Une armée sous une bannière claire. Puis un feu immense. « Tu traverseras les cendres, Jeanne. Le royaume aura besoin de toi. »",
        "choices": [
          {
            "id": "repondre",
            "label": "« Qui êtes-vous ? »",
            "effects": [],
            "next_scene": "sc_p0_fumee"
